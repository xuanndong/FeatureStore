# --- Application Config ---
PROJECT_NAME="Aether Feature Store"
ENVIRONMENT="development"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/aether_db"

# --- Cache & Online Store (Redis) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# --- Message Queue (Kafka KRaft) ---
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_JOB_TOPIC="aether-job-commands"
KAFKA_STATUS_TOPIC="aether-job-status"

# --- Security (Optional for now) ---
SECRET_KEY="your-super-secret-key-for-jwt"
ALGORITHM="HS256"

# --- MinIO Storage ---
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="password123"

OFFLINE_STORE_URI="s3://aether-offline-store"

# --- Webhooks ---
WEBHOOK_URL="http://localhost:3000/studio/webhook/status"

# --- Worker Init ---
AETHER_MAX_WORKERS=2

RAY_CLUSTER_ADDRESS=local # local | ray://192.168.1.100:10001
