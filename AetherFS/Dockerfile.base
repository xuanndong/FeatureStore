FROM python:3.10-slim

# Ngăn Python tạo ra các tệp .pyc và đảm bảo log được đẩy thẳng ra console
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# 1. Cài đặt các thư viện hệ thống cần thiết cho Vision, Audio và Video
# - libgl1 & libglib2.0: Cần cho OpenCV
# - ffmpeg: Cần cho xử lý Video
# - libsndfile1: Cần cho xử lý Audio (librosa)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    ffmpeg \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/*

# 2. Cài đặt các thư viện học máy từ file base.requirements.txt
COPY base.requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r base.requirements.txt

# 3. Tải sẵn các tài nguyên ngôn ngữ cơ bản (NLP)
RUN python -m spacy download en_core_web_sm

CMD ["python"]

# Run image
# docker build -t aether-base:latest -f Dockerfile.base .
